/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  MX_TIM8_Init();
  MX_USART1_UART_Init();
  MX_ADC1_Init();
  MX_ICACHE_Init();
  /* USER CODE BEGIN 2 */
  uint32_t last_uart_tick = 0;
  const uint8_t boot_message[] = "STM32 booted, PWM active\r\n";

  if (PWM_MAX_DUTY_TICKS > PWM_PERIOD_TICKS)
  {
    Error_Handler();
  }

  StartAllPwmChannels();
  Motor_CoastAll();
  last_motor_command_tick = HAL_GetTick();

  Encoder_InitStates();

  HAL_UART_Transmit(&huart1, boot_message, sizeof(boot_message) - 1U, HAL_MAX_DELAY);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    PiUart_Poll();

    if ((MOTOR_COMMAND_TIMEOUT_MS > 0U) &&
        ((HAL_GetTick() - last_motor_command_tick) >= MOTOR_COMMAND_TIMEOUT_MS))
    {
      Motor_CoastAll();
    }

    if ((HAL_GetTick() - last_uart_tick) >= UART_HEARTBEAT_MS)
    {
      char heartbeat_message[128];
      int heartbeat_length;
      uint16_t adc_values[ADC_CHANNEL_COUNT];

      last_uart_tick = HAL_GetTick();
      ADC_ReadAll(adc_values);
      heartbeat_length = snprintf(heartbeat_message, sizeof(heartbeat_message),
                                  "ENC %ld %ld %ld %ld %ld %ld ADC %u %u %u %u %u\r\n",
                                  (long)Encoder_GetCount(0U),
                                  (long)Encoder_GetCount(1U),
                                  (long)Encoder_GetCount(2U),
                                  (long)Encoder_GetCount(3U),
                                  (long)Encoder_GetCount(4U),
                                  (long)Encoder_GetCount(5U),
                                  adc_values[0],
                                  adc_values[1],
                                  adc_values[2],
                                  adc_values[3],
                                  adc_values[4]);
      if (heartbeat_length > 0)
      {
        HAL_UART_Transmit(&huart1, (uint8_t *)heartbeat_message, (uint16_t)heartbeat_length, HAL_MAX_DELAY);
      }
    }
  }
  /* USER CODE END 3 */
}

